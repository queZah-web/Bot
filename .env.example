# انسخ هذا الملف باسم .env واملأ القيم (لا ترفع .env على GitHub أبداً)

# توكن البوت من @BotFather
BOT_TOKEN=

# ايدي حسابك في تيليجرام (رقم) — تعرفه من @userinfobot
OWNER_ID=

# اختياري
# DB_PATH=data/zhoo.db
# LOG_LEVEL=INFO

# اختياري: الذكاء الاصطناعي (Claude من Anthropic) — مدفوع حسب الاستخدام
